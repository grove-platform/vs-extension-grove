{
  "name": "grove-platform-nodejs",
  "displayName": "Grove UI for Node.js",
  "description": "Node.js/Jest support for Grove documentation testing",
  "version": "0.0.15",
  "publisher": "GrovePlatform",
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Grove Node.js test commands are disabled in untrusted workspaces because npm test executes project scripts."
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/snip.js"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "GrovePlatform.grove-platform-core"
  ],
  "contributes": {
    "commands": [
      {
        "command": "grove.nodejs.runTests",
        "title": "Grove: Run Node.js Tests"
      },
      {
        "command": "grove.nodejs.runTestFile",
        "title": "Grove: Run Current Node.js Test File"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "test": "vitest run",
    "lint": "eslint src --ext ts",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@grove/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.27.0",
    "vitest": "^4.0.18"
  }
}
