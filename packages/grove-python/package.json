{
  "name": "grove-platform-python",
  "displayName": "Grove UI for Python",
  "description": "Python (pytest and unittest) support for Grove documentation testing",
  "version": "0.0.4",
  "publisher": "GrovePlatform",
  "engines": {
    "vscode": "^1.110.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Grove Python test commands are disabled in untrusted workspaces because pytest/unittest execute project code."
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/snip.js"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "GrovePlatform.grove-platform-core"
  ],
  "contributes": {
    "commands": [
      {
        "command": "grove.python.runTests",
        "title": "Grove: Run Python Tests"
      },
      {
        "command": "grove.python.runTestFile",
        "title": "Grove: Run Current Python Test File"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "test": "vitest run",
    "lint": "eslint src --ext ts",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@grove/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.27.0",
    "vitest": "^4.0.18"
  }
}
