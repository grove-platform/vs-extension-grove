{
  "name": "grove-core",
  "displayName": "Grove",
  "description": "MongoDB documentation code example testing platform",
  "version": "0.0.21",
  "publisher": "mongodb",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/snip.js"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Grove",
      "properties": {
        "grove.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect Grove projects on workspace open"
        },
        "grove.bluehawkPath": {
          "type": "string",
          "default": "",
          "description": "Path to bluehawk CLI (uses npx if empty)"
        },
        "grove.feedback.jiraProjectId": {
          "type": "string",
          "default": "14181",
          "description": "Jira project ID for feedback tickets (DOCSP = 14181)"
        },
        "grove.feedback.includeDiagnosticsByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Include diagnostic information by default"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grove",
          "title": "Grove",
          "icon": "resources/grove-icon.svg"
        }
      ]
    },
    "views": {
      "grove": [
        {
          "type": "webview",
          "id": "grove.panel",
          "name": "Grove"
        },
        {
          "type": "webview",
          "id": "grove.bluehawkPreview",
          "name": "Bluehawk Preview"
        }
      ]
    },
    "commands": [
      {
        "command": "grove.runTests",
        "title": "Grove: Run Tests"
      },
      {
        "command": "grove.createSymlink",
        "title": "Grove: Create Symlink for Documentation"
      },
      {
        "command": "grove.connectMongo",
        "title": "Grove: Connect to MongoDB"
      },
      {
        "command": "grove.disconnectMongo",
        "title": "Grove: Disconnect from MongoDB"
      },
      {
        "command": "grove.showDatabases",
        "title": "Grove: Show Databases"
      },
      {
        "command": "grove.openBluehawkPreview",
        "title": "Grove: Open Bluehawk Preview"
      },
      {
        "command": "grove.showPerformanceReport",
        "title": "Grove: Show Performance Report (Debug)"
      },
      {
        "command": "grove.clearPerformanceStats",
        "title": "Grove: Clear Performance Statistics (Debug)"
      },
      {
        "command": "grove.savePerformanceReport",
        "title": "Grove: Save Performance Report (Debug)"
      },
      {
        "command": "grove.comparePerformanceReports",
        "title": "Grove: Compare Performance Reports (Debug)"
      },
      {
        "command": "grove.openProfilerPanel",
        "title": "Grove: Open Performance Monitor (Debug)"
      },
      {
        "command": "grove.sendFeedback",
        "title": "Send Feedback",
        "category": "Grove"
      },
      {
        "command": "grove.refreshPanel",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "grove.refreshPanel",
          "when": "view == grove.panel",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "editor.codeLensFontSize": 14
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --define:process.env.NODE_ENV=\\\"production\\\" --sourcemap=external --target=node18",
    "build:dev": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap=inline --target=node18",
    "watch": "pnpm run build:dev -- --watch",
    "package": "pnpm run build && vsce package --no-dependencies",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grove/shared": "workspace:*",
    "js-yaml": "^4.1.1",
    "mongodb": "^7.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.0",
    "vitest": "^4.0.18"
  }
}
