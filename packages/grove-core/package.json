{
  "name": "grove-core",
  "displayName": "Grove",
  "description": "MongoDB documentation code example testing platform",
  "version": "0.0.1",
  "publisher": "mongodb",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/snip.js"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grove",
          "title": "Grove",
          "icon": "resources/grove-icon.svg"
        }
      ]
    },
    "views": {
      "grove": [
        {
          "type": "webview",
          "id": "grove.panel",
          "name": "Grove"
        }
      ]
    },
    "commands": [
      {
        "command": "grove.copyMcpConfig",
        "title": "Grove: Copy MCP Configuration"
      },
      {
        "command": "grove.refreshPanel",
        "title": "Grove: Refresh Panel"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@grove/shared": "workspace:*",
    "@mongodb/grove-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.27.0"
  }
}
