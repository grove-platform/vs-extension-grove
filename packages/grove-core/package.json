{
  "name": "grove-core",
  "displayName": "Grove",
  "description": "MongoDB documentation code example testing platform",
  "version": "0.0.1",
  "publisher": "mongodb",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/snip.js"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Grove",
      "properties": {
        "grove.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect Grove projects on workspace open"
        },
        "grove.bluehawkPath": {
          "type": "string",
          "default": "",
          "description": "Path to bluehawk CLI (uses npx if empty)"
        },
        "grove.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Grove status in the status bar"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grove",
          "title": "Grove",
          "icon": "resources/grove-icon.svg"
        }
      ]
    },
    "views": {
      "grove": [
        {
          "type": "webview",
          "id": "grove.panel",
          "name": "Grove"
        },
        {
          "type": "webview",
          "id": "grove.bluehawkPreview",
          "name": "Bluehawk Preview"
        }
      ]
    },
    "commands": [
      {
        "command": "grove.refreshPanel",
        "title": "Grove: Refresh Panel"
      },
      {
        "command": "grove.runTests",
        "title": "Grove: Run Tests"
      },
      {
        "command": "grove.createSymlink",
        "title": "Grove: Create Symlink for Documentation"
      },
      {
        "command": "grove.connectMongo",
        "title": "Grove: Connect to MongoDB"
      },
      {
        "command": "grove.disconnectMongo",
        "title": "Grove: Disconnect from MongoDB"
      },
      {
        "command": "grove.showDatabases",
        "title": "Grove: Show MongoDB Databases"
      },
      {
        "command": "grove.openBluehawkPreview",
        "title": "Grove: Open Bluehawk Preview"
      },
      {
        "command": "grove.refreshBluehawkPreview",
        "title": "Grove: Refresh Bluehawk Preview"
      },
      {
        "command": "grove.literalinclude.view",
        "title": "Grove: View Literalinclude File"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grove/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.27.0",
    "vitest": "^4.0.18"
  }
}
