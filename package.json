{
  "name": "grove-extension",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "watch": "pnpm -r --parallel watch",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "package": "pnpm -r --filter './packages/grove-*' package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "1.2.2",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "markdown-it@<14.3.1": "14.3.1",
      "fast-uri@<3.1.7": "3.1.7",
      "undici@<7.29.1": "7.29.1",
      "js-yaml@<4.3.2": "4.3.2",
      "vitest@<4.1.11": "4.1.11",
      "@vitest/mocker@<4.1.11": "4.1.11",
      "nanoid@<3.3.18": "3.3.18",
      "@humanfs/node@<0.16.8": "0.16.8",
      "postcss@<=8.5.22": "8.5.23",
      "linkify-it@<=5.0.1": "5.0.2",
      "form-data@<4.0.6": "4.0.6",
      "vite@<=7.3.4": "7.3.5",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "tmp@<0.2.6": "0.2.6",
      "qs@<=6.15.1": "6.15.2",
      "uuid@<11.1.1": "11.1.1",
      "lodash@<=4.17.23": "4.18.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "flatted@<=3.4.1": "3.4.2"
    }
  }
}
